    <Border CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Margin="0,0,14,0" Padding="10"><DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="项目工作区" FontWeight="SemiBold" Margin="8,7,8,14"/>
