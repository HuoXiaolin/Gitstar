e"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel></Button><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Content="更新日志" Tag="{Binding}" Click="Notes_Click" Padding="10,6" Margin="0,0,5,0"/><Button Content="···" Tag="{Binding}" Click="Options_Click" Grid.Column="1" Padding="0,6" Margin="0"/></Grid></StackPanel>
   </Grid></DockPanel></Border>
  </DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><Image Source="Assets/Gitstar.png" Width="98" Height="98" Opacity="0.8"/><TextBlock Text="{Binding Empty}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,10"/><TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center"/></StackPanel>
   </Grid></DockPanel>
