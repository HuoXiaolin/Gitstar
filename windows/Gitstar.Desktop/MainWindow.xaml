<Window x:Class="Gitstar.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Gitstar.Desktop" Title="Gitstar" Width="1180" Height="760" MinWidth="940" MinHeight="520" WindowStartupLocation="Manual" Background="{DynamicResource Background}" Icon="Assets/Gitstar.ico" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Background" Color="#F4F6FC" />
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Ink" Color="#202A44" />
      <SolidColorBrush x:Key="Muted" Color="#67748E" />
      <SolidColorBrush x:Key="Edge" Color="#E6EAF4" />
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Padding" Value="10,8" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" x:Name="ComboFrame" />
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="SelectionText" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="12,0,30,0" IsHitTestVisible="False" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Text="{Binding Text,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" Margin="12,0,30,0" Visibility="Collapsed" />
                <TextBlock Text="" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                  <Border MinWidth="{TemplateBinding ActualWidth}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8" Padding="4">
                    <ScrollViewer MaxHeight="300">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="SelectionText" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="Panel" Color="#EDF2F8" />
      <SolidColorBrush x:Key="Accent" Color="#386AC6" />
      <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FC" />
      <SolidColorBrush x:Key="AccentInk" Color="#2F5FAA" />
      <SolidColorBrush x:Key="ProjectSelection" Color="#EAF0FC" />
      <SolidColorBrush x:Key="StableSoft" Color="#E5F3EC" />
      <SolidColorBrush x:Key="StableInk" Color="#267554" />
      <SolidColorBrush x:Key="BetaSoft" Color="#FCF1DB" />
      <SolidColorBrush x:Key="BetaInk" Color="#8E6429" />
      <Style x:Key="ProjectAddressButton" TargetType="Button" BasedOn="{StaticResource TertiaryButton}">
        <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="1,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="26,10,26,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="BrandRow">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/Gitstar.png" Width="38" Height="38" Margin="0,0,10,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Gitstar" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="收藏 · 发现 · 更新" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,1,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Padding="12,6" Content="任务" Click="Tasks_Click" Style="{StaticResource TertiaryButton}" />
        <Button Padding="12,6" Content="设置" Click="Settings_Click" Style="{StaticResource TertiaryButton}" />
        <Button Padding="12,6" Content="{Binding Account}" Click="Login_Click" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Margin="0" Style="{StaticResource NavButton}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,0">
        <Button Padding="13,9" x:Name="RecentButton" Click="Recent_Click" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
            <TextBlock Text="最近更新" />
          </StackPanel>
        </Button>
        <Button Padding="13,9" x:Name="LocalButton" Click="Local_Click" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
            <TextBlock Text="本机可更新" />
          </StackPanel>
        </Button>
        <Button Padding="13,9" x:Name="ProjectsButton" Click="Projects_Click" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
            <TextBlock Text="我的项目" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="PageHeaderRow" Grid.Row="1" Margin="0,14,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Border x:Name="CountPanel" Grid.Column="1" CornerRadius="12" Padding="18,12" VerticalAlignment="Center" Margin="18,0,0,0" Background="{DynamicResource AccentSoft}" BorderThickness="0">
        <StackPanel>
          <TextBlock x:Name="CheckFrequencyLabel" Text="{Binding CountCaption}" Foreground="{DynamicResource AccentInk}" FontSize="11" />
          <TextBlock Text="{Binding Count}" Foreground="{DynamicResource AccentInk}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="UpdatesToolbar" Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
        <TextBox x:Name="Search" TextChanged="Filter_Changed" ToolTip="搜索仓库、软件、版本" />
        <TextBlock Text="搜索仓库、软件、版本" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text,ElementName=Search}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <ComboBox x:Name="GroupFilter" Grid.Column="1" SelectionChanged="Filter_Changed" Margin="0,0,12,0" ToolTip="收藏分组" Visibility="Collapsed" />
      <ComboBox x:Name="ChannelFilter" Grid.Column="2" SelectionChanged="Filter_Changed" SelectedIndex="1" Margin="0,0,12,0">
        <ComboBoxItem Content="仅正式版" />
        <ComboBoxItem Content="正式 + 测试" />
        <ComboBoxItem Content="仅测试版" />
      </ComboBox>
      <ComboBox x:Name="SortFilter" Grid.Column="3" SelectionChanged="Sort_Changed" SelectedIndex="0" Margin="0,0,12,0" ToolTip="发布时间：Release 发布的时间；更新时间：GitHub 仓库的 updated_at。按时间从新到旧排列，切换时不扫描。">
        <ComboBoxItem Content="按发布时间" />
        <ComboBoxItem Content="按更新时间" />
      </ComboBox>
      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <Button x:Name="BulkDownloadButton" Content="批量下载" Click="BulkDownload_Click" />
        <Button x:Name="BatchButton" Content="关注管理" Click="BatchManage_Click" />
        <Button x:Name="RemindersButton" Content="软件管理" Click="Reminders_Click" Visibility="Collapsed" />
        <Button x:Name="AddButton" Content="添加项目" Click="Add_Click" />
        <Button Content="检查更新" Click="Refresh_Click" Margin="0" />
      </StackPanel>
    </Grid>
    <Grid x:Name="UpdatesContent" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="208" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="GroupPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="14" Margin="0,0,14,0" Padding="10,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="6,0,6,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="收藏分组" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="＋" Padding="5,2" Margin="0" Click="NewGroup_Click" ToolTip="新建分组" />
            </Grid>
            <TextBlock Text="点击分组快速查看" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0" />
          </StackPanel>
          <ListBox x:Name="GroupSidebar" PreviewMouseRightButtonDown="Groups_RightClick" ContextMenuOpening="GroupMenu_Opening" ItemsSource="{Binding Groups}" SelectionChanged="Sidebar_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="重命名 / 修改说明" Click="EditGroup_Click" />
                <MenuItem Header="删除分组（保留 Star）" Click="DeleteGroup_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" CornerRadius="9" Padding="10" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                          <Setter Property="Foreground" Value="#3467DE" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="13" />
                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Margin="6,1,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,8,10">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectionMode}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Content="全选当前列表" Click="SelectAll_Click" Padding="12,6" />
          <Button Content="清空选择" Click="ClearSelection_Click" Padding="12,6" />
          <Button Content="退出选择" Click="ExitSelection_Click" Padding="12,6" />
        </StackPanel>
        <Grid>
          <ListBox ItemsSource="{Binding Cards}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="14" Margin="0,0,8,12" Padding="18,17" x:Name="ReleaseCard">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" ToolTip="选择此项目" IsChecked="{Binding IsSelected,Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,12,0">
                      <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectionMode,RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanManageStar}" Value="False">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </CheckBox.Style>
                    </CheckBox>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <local:OwnerAvatar Grid.RowSpan="3" Repository="{Binding Repository}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                      <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Tag="{Binding}" Click="CopyProjectAddress_Click" ToolTip="复制项目地址" AutomationProperties.Name="复制项目地址" Style="{StaticResource ProjectAddressButton}">
                              <Path Data="M 5,2 L 14,2 L 14,11 M 2,5 L 11,5 L 11,14 L 2,14 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                            </Button>
                            <Button Tag="{Binding}" Click="ProjectHome_Click" ToolTip="打开项目主页" AutomationProperties.Name="打开项目主页" Style="{StaticResource ProjectAddressButton}">
                              <Path Data="M 8,2 L 14,2 L 14,8 M 14,2 L 7,9 M 5,3 L 2,3 L 2,14 L 13,14 L 13,11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                            </Button>
                            <TextBlock Text="{Binding FollowSource}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding Repository}" ToolTip="{Binding Repository}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                        </DockPanel>
                        <local:RepositoryFacts Grid.Column="1" Repository="{Binding Repository}" Metadata="{Binding Metadata}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                          <Border CornerRadius="4" Padding="7,3">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource StableSoft}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Release.Prerelease}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BetaSoft}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Channel}" FontSize="11">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource StableInk}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Release.Prerelease}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource BetaInk}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                          <TextBlock Text="{Binding Version}" ToolTip="{Binding VersionEvidence}" FontWeight="SemiBold" Margin="10,3,14,0" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding Date}" ToolTip="{Binding DateHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" MaxHeight="54">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Width="142">
                        <Button Tag="{Binding}" Click="Download_Click" Background="{Binding Accent}" Foreground="White" BorderThickness="0" Margin="0,0,0,8" ToolTip="{Binding Transfer.Detail}" ToolTipService.ShowOnDisabled="True">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Transfer.Active}" Value="True">
                                  <Setter Property="IsEnabled" Value="False" />
                                  <Setter Property="Opacity" Value="1" />
                                  <Setter Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <StackPanel MinWidth="110">
                            <TextBlock Text="{Binding Action}" HorizontalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transfer.Label}" Value="">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Transfer.Label}" HorizontalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transfer.Label}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Value="{Binding Transfer.Percentage}" IsIndeterminate="{Binding Transfer.Indeterminate}" Maximum="100" Height="4" Margin="0,5,0,0" Foreground="White" Background="#40FFFFFF" BorderThickness="0">
                              <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transfer.Active}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ProgressBar.Style>
                            </ProgressBar>
                          </StackPanel>
                        </Button>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="34" />
                          </Grid.ColumnDefinitions>
                          <Button Content="更新日志" Tag="{Binding}" Click="Notes_Click" Padding="10,6" Margin="0,0,5,0" Style="{StaticResource TertiaryButton}" />
                          <Button Content="···" Tag="{Binding}" Click="Options_Click" Grid.Column="1" Padding="0,6" Margin="0" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="ReleaseCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ReleaseCard" Property="BorderBrush" Value="{DynamicResource Accent}" />
                  </Trigger>
                  <Trigger SourceName="ReleaseCard" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="ReleaseCard" Property="BorderBrush" Value="{DynamicResource Accent}" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Image Source="Assets/Gitstar.png" Width="98" Height="98" Opacity="0.8" />
            <TextBlock Text="{Binding Empty}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,10" />
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Grid>
    <Grid x:Name="ProjectsHost" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0">
          <TextBox x:Name="ProjectSearch" TextChanged="ProjectFilter_Changed" ToolTip="搜索项目名称与说明" />
          <TextBlock Text="搜索我的项目" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text,ElementName=ProjectSearch}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <ComboBox x:Name="ProjectFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="ProjectFilter_Changed" Margin="0,0,12,0">
          <ComboBoxItem Content="全部项目" />
          <ComboBoxItem Content="公开项目" />
          <ComboBoxItem Content="私有项目" />
          <ComboBoxItem Content="已关联本地" />
        </ComboBox>
          <WrapPanel Grid.Column="2">
            <ComboBox x:Name="ProjectSort" SelectedIndex="1" SelectionChanged="ProjectSort_Changed" Margin="0,0,12,0" ToolTip="发布时间：项目中最近发布的 Release；更新时间：GitHub 仓库的 updated_at。缺少发布时间的项目排在末尾，切换不联网。">
              <ComboBoxItem Content="按发布时间" />
              <ComboBoxItem Content="按更新时间" />
            </ComboBox>
          <Button Content="创建项目" Click="CreateProject_Click" />
          <Button Content="刷新项目列表" Click="SyncProjects_Click" />
          <Button x:Name="AllAutoPublishButton" Content="全部同步并发布最新" Click="AllAutoPublish_Click" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Margin="0" />
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="246" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Margin="0,0,14,0" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="项目工作区" FontWeight="SemiBold" Margin="8,7,8,14" />
            <ListBox x:Name="ProjectList" SelectionChanged="ProjectSelection_Changed" ItemsSource="{Binding Projects}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,7" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="Transparent" Padding="12" CornerRadius="10">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ProjectSelection}" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Opacity" Value="0.75" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,3,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding FullName}" ToolTip="{Binding FullName}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,0,0,0">
                        <Button Tag="{Binding}" Click="CopyProjectAddress_Click" ToolTip="复制项目地址" AutomationProperties.Name="复制项目地址" Style="{StaticResource ProjectAddressButton}">
                          <Path Data="M 5,2 L 14,2 L 14,11 M 2,5 L 11,5 L 11,14 L 2,14 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                        <Button Tag="{Binding}" Click="ProjectHome_Click" ToolTip="打开项目主页" AutomationProperties.Name="打开项目主页" Style="{StaticResource ProjectAddressButton}">
                          <Path Data="M 8,2 L 14,2 L 14,8 M 14,2 L 7,9 M 5,3 L 2,3 L 2,14 L 13,14 L 13,11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Visibility}" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Access}" Foreground="{DynamicResource Muted}" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ProjectDetails" Margin="0,0,6,0" />
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="4" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,8,0,0">
      <Button x:Name="StatusButton" Click="StatusDetails_Click" HorizontalContentAlignment="Stretch" Padding="0,3" Margin="0" Height="26" MinHeight="26" ToolTip="点击查看完整消息" AutomationProperties.Name="查看消息详情" Style="{StaticResource TertiaryButton}">
        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="StatusFrame" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusFrame" Property="Background" Value="{DynamicResource AccentSoft}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StatusFrame" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="StatusFrame" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusSummary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="详情 ›" Foreground="{DynamicResource Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Border>
  </Grid>
</Window>
