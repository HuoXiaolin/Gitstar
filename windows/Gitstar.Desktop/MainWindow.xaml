    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ProjectDetails" Margin="0,0,6,0"/></ScrollViewer>
   </Grid>
